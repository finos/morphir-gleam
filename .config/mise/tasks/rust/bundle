#!/usr/bin/env bun
//MISE description="Assemble the morphir-gleam release bundle (flags: --wasm <path>, --out <dir>, --git-commit <sha>)"

import { readFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { describe, writeBundle } from "../../../../.github/scripts/gleam-extension/bundle.ts";

const root = resolve(import.meta.dir, "../../../..");
const crate = join(root, "rust/crates/morphir-gleam-binding");

function flag(name: string, fallback: string): string {
  const at = process.argv.indexOf(`--${name}`);
  return at >= 0 && process.argv[at + 1] ? process.argv[at + 1] : fallback;
}

const cargo = readFileSync(join(crate, "Cargo.toml"), "utf8");
const version = /^version = "([^"]+)"$/m.exec(cargo)?.[1];
if (!version) throw new Error("cannot read the crate version");
const gitCommit = flag("git-commit", Bun.spawnSync(["git", "rev-parse", "HEAD"], { cwd: root }).stdout.toString().trim());
const wasmPath = resolve(flag("wasm", join(root, "rust/target/wasm32-unknown-unknown/release/morphir_gleam_binding.wasm")));
const out = resolve(flag("out", join(root, "rust/target/bundle")));

const wasm = new Uint8Array(readFileSync(wasmPath));
const files = writeBundle(out, {
  wasm,
  version,
  gitCommit,
  claims: await describe(wasm),
  expectedClaims: JSON.parse(readFileSync(join(crate, "claims/expected.json"), "utf8")),
});
console.log(`bundle ${version} (${gitCommit}) in ${out}:`);
for (const file of files) console.log(`  ${file}`);
