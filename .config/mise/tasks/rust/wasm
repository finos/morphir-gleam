#!/usr/bin/env bash
#MISE description="Build the Gleam extension core-Wasm guest, validate it and run the host tests on it"
. "$(dirname "$0")/_env.sh"
cargo build --locked --release --target wasm32-unknown-unknown -p morphir-gleam-binding
wasm=target/wasm32-unknown-unknown/release/morphir_gleam_binding.wasm
wasm-tools validate "$wasm"
echo "validated $wasm ($(wc -c <"$wasm" | tr -d ' ') bytes)"
MORPHIR_GLEAM_GUEST="$PWD/$wasm" cargo test --locked --profile guest-test \
    --features guest-host-tests --test core_wasm -- --include-ignored --show-output
